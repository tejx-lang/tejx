extern function rt_net_accept(listener: int64): int64;
extern function rt_net_send(stream: int64, data: string): int;
extern function rt_net_send_bytes(stream: int64, data: int[]): int;
extern function rt_net_receive(stream: int64, max_len: int): string;
extern function rt_net_receive_bytes(stream: int64, max_len: int): int[];
extern function rt_net_read_all(stream: int64, chunk_size: int): string;
extern function rt_net_read_all_bytes(stream: int64, chunk_size: int): int[];
extern function rt_net_read_exact_bytes(stream: int64, expected_len: int): int[];
extern function rt_net_set_timeout(stream: int64, timeout_ms: int): int;
extern function rt_net_start_tls(stream: int64, host: string): int;
extern function rt_net_start_tls_insecure(stream: int64, host: string): int;
extern function rt_TcpStream_constructor(_this: TcpStream, id: int64): void;
extern function rt_TcpListener_constructor(_this: TcpListener, id: int64): void;

extern function rt_net_connect(addr: string): int64;
extern function rt_net_connect_host(host: string, port: int): int64;
extern function rt_net_connect_tls(host: string, port: int): int64;
extern function rt_net_connect_tls_insecure(host: string, port: int): int64;
extern function rt_net_lookup(host: string): Optional<string>;
extern function rt_net_lookup_all(host: string): string[];
extern function rt_net_listen(addr: string): int64;
extern function rt_net_close(stream: int64): int;
extern function rt_net_close_listener(listener: int64): int;

function _net_connect_stream(addr: string): Optional<TcpStream> {
    let id = rt_net_connect(addr);
    if (id <= 0) return None;
    return new TcpStream(id);
}

function _net_connect_host_stream(host: string, port: int): Optional<TcpStream> {
    let id = rt_net_connect_host(host, port);
    if (id <= 0) return None;
    return new TcpStream(id);
}

function _net_connect_tls_stream(host: string, port: int, insecure: bool = false): Optional<TcpStream> {
    let id = insecure
        ? rt_net_connect_tls_insecure(host, port)
        : rt_net_connect_tls(host, port);
    if (id <= 0) return None;
    return new TcpStream(id);
}

function _net_lookup_host(host: string): Optional<string> {
    return rt_net_lookup(host);
}

function _net_lookup_all_hosts(host: string): string[] {
    return rt_net_lookup_all(host);
}

function _net_listen_on(addr: string): TcpListener {
    let id = rt_net_listen(addr);
    if (id <= 0) {
        throw new Error("Listen failed on " + addr);
    }
    return new TcpListener(id);
}

function _net_close_stream(id: int64): void {
    if (id <= 0) return;
    let res = rt_net_close(id);
    if (res == -1) {
        throw new Error("Invalid stream");
    }
}

function _net_close_listener(id: int64): void {
    if (id <= 0) return;
    rt_net_close_listener(id);
}

function _net_close_any(stream: Optional<any>): void {
    if (stream == None) return;

    let value: any = stream;
    if (value instanceof TcpStream) {
        value.close();
        return;
    }

    let id: int64 = value as int64;
    if (id <= 0) return;
    _net_close_stream(id);
}

export class TcpStream {
    private id: int64;

    constructor(id: int64) {
        rt_TcpStream_constructor(this, id);
    }

    write(data: string): bool {
        if (!this.isOpen()) return false;
        return rt_net_send(this.id, data) > 0;
    }

    send(data: string): bool {
        return this.write(data);
    }

    writeBytes(data: int[]): bool {
        if (!this.isOpen()) return false;
        return rt_net_send_bytes(this.id, data) >= 0;
    }

    read(max_len: int): string {
        if (!this.isOpen()) return "";
        return rt_net_receive(this.id, max_len);
    }

    readBytes(max_len: int): int[] {
        if (!this.isOpen()) return [];
        return rt_net_receive_bytes(this.id, max_len);
    }

    readAll(): string {
        if (!this.isOpen()) return "";
        return rt_net_read_all(this.id, 4096);
    }

    readAllBytes(): int[] {
        if (!this.isOpen()) return [];
        return rt_net_read_all_bytes(this.id, 4096);
    }

    readExactBytes(expected_len: int): Optional<int[]> {
        if (!this.isOpen()) return None;
        let data = rt_net_read_exact_bytes(this.id, expected_len);
        if (expected_len >= 0 && data.length() == expected_len) {
            return data;
        }
        return None;
    }

    receive(max_len: int): string {
        return this.read(max_len);
    }

    startTls(host: string): bool {
        if (!this.isOpen()) return false;
        return rt_net_start_tls(this.id, host) == 0;
    }

    startTlsInsecure(host: string): bool {
        if (!this.isOpen()) return false;
        return rt_net_start_tls_insecure(this.id, host) == 0;
    }

    setTimeout(timeout_ms: int): bool {
        if (!this.isOpen()) return false;
        return rt_net_set_timeout(this.id, timeout_ms) == 0;
    }

    isOpen(): bool {
        return this.id > 0;
    }

    close(): void {
        if (!this.isOpen()) return;
        _net_close_stream(this.id);
        this.id = 0;
    }
}

export class TcpListener {
    private id: int64;

    constructor(id: int64) {
        rt_TcpListener_constructor(this, id);
    }

    static bind(addr: string): TcpListener {
        return _net_listen_on(addr);
    }

    tryAccept(): Optional<TcpStream> {
        let sid = rt_net_accept(this.id);
        if (sid == 0) {
            return None;
        }
        if (sid < 0) {
            throw new Error("Accept failed");
        }
        return new TcpStream(sid);
    }

    accept(): TcpStream {
        let stream = this.tryAccept();
        if (stream == None) {
            throw new Error("Accept failed");
        }
        return stream as TcpStream;
    }

    isOpen(): bool {
        return this.id > 0;
    }

    close(): void {
        if (!this.isOpen()) return;
        _net_close_listener(this.id);
        this.id = 0;
    }
}
