class JsonParser {
    s: string;
    index: int;
    len: int;

    constructor(s: string) {
        this.s = s;
        this.index = 0;
        this.len = s.length();
    }

    skipWhitespace() {
        while (this.index < this.len) {
            let ch = this.s[this.index];
            if (ch == " " || ch == "\n" || ch == "\t" || ch == "\r") {
                this.index++;
            } else {
                break;
            }
        }
    }

    parseString(): string {
        this.index++;
        let res = "";
        while (this.index < this.len) {
            let ch = this.s[this.index];
            if (ch == "\"") {
                this.index++;
                return res;
            }
            if (ch == "\\") {
                this.index++;
                if (this.index < this.len) {
                    let esc = this.s[this.index];
                    if (esc == "\"") res = res + "\"";
                    else if (esc == "\\") res = res + "\\";
                    else if (esc == "/") res = res + "/";
                    else if (esc == "b") res = res + "\b";
                    else if (esc == "f") res = res + "\f";
                    else if (esc == "n") res = res + "\n";
                    else if (esc == "r") res = res + "\r";
                    else if (esc == "t") res = res + "\t";
                    else res = res + esc;
                }
            } else {
                res = res + ch;
            }
            this.index++;
        }
        throw new Error("SyntaxError: Unterminated string in JSON");
    }

    parseNumber(): float {
        let start = this.index;
        if (this.index < this.len && this.s[this.index] == "-") this.index++;

        while (this.index < this.len) {
            let ch = this.s[this.index];
            if ((ch >= "0" && ch <= "9") || ch == "." || ch == "e" || ch == "E" || ch == "+" || ch == "-") {
                this.index++;
            } else {
                break;
            }
        }

        if (start == this.index) throw new Error("SyntaxError: Expected number");

        let numStr = this.s.substring(start, this.index);
        return parseFloat(numStr);
    }

    parseArray(): any[] {
        this.index++;
        let res: any[] = [];
        this.skipWhitespace();

        if (this.index < this.len && this.s[this.index] == "]") {
            this.index++;
            return res;
        }

        while (this.index < this.len) {
            let item: any = this.parseValue();
            res.push(item);
            this.skipWhitespace();

            let ch = this.s[this.index];
            if (ch == ",") {
                this.index++;
            } else if (ch == "]") {
                this.index++;
                return res;
            } else {
                throw new Error("SyntaxError: Expected ',' or ']' after array element");
            }
        }

        throw new Error("SyntaxError: Unterminated array");
    }

    parseObject(): any {
        this.index++;
        let res: any = {};
        this.skipWhitespace();

        if (this.index < this.len && this.s[this.index] == "}") {
            this.index++;
            return res;
        }

        while (this.index < this.len) {
            this.skipWhitespace();
            if (this.s[this.index] != "\"") throw new Error("SyntaxError: Expected string key in object");

            let key = this.parseString();
            this.skipWhitespace();

            if (this.s[this.index] != ":") throw new Error("SyntaxError: Expected ':' after property key");
            this.index++;

            let val: any = this.parseValue();
            res[key] = val;

            this.skipWhitespace();
            let ch = this.s[this.index];
            if (ch == ",") {
                this.index++;
            } else if (ch == "}") {
                this.index++;
                return res;
            } else {
                throw new Error("SyntaxError: Expected ',' or '}' after property value");
            }
        }

        throw new Error("SyntaxError: Unterminated object");
    }

    parseLiteral(word: string, returnValue: any): any {
        let wordLen = word.length();
        let slice = this.s.substring(this.index, this.index + wordLen);
        if (slice == word) {
            this.index = this.index + wordLen;
            return returnValue;
        }
        throw new Error("SyntaxError: Unexpected token at index " + rt_to_string(this.index));
    }

    parseValue(): any {
        this.skipWhitespace();
        if (this.index >= this.len) throw new Error("SyntaxError: Unexpected end of JSON input");

        let ch = this.s[this.index];
        if (ch == "{") return this.parseObject();
        if (ch == "[") return this.parseArray();
        if (ch == "\"") return this.parseString();
        if (ch == "t") return this.parseLiteral("true", true);
        if (ch == "f") return this.parseLiteral("false", false);
        if (ch == "n") return this.parseLiteral("null", None);
        if ((ch >= "0" && ch <= "9") || ch == "-") return this.parseNumber();

        throw new Error("SyntaxError: Unexpected token '" + ch + "'");
    }

    parse(): any {
        let result: any = this.parseValue();
        this.skipWhitespace();
        if (this.index < this.len) {
            throw new Error("SyntaxError: Unexpected data after JSON payload");
        }
        return result;
    }
}

function _json_parse(s: string): any {
    let parser = new JsonParser(s);
    return parser.parse();
}
