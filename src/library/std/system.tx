import "./system/process.tx";
import std:collections;

// ── Top-level convenience exports ─────────────────────────────────────────────

export function exit(code: int): void {
    _system_exit(code);
}

export function args(): string[] {
    return _system_args();
}

export function getEnv(key: string): Optional<string> {
    return _system_get_env(key);
}

export function getAllEnv(): Map<string, string> {
    let arr = _system_get_all_env();
    let map = new Map<string, string>();
    for (let i = 0; i < arr.length(); i = i + 2) {
        map.set(arr[i], arr[i + 1]);
    }
    return map;
}

export function getOSType(): string {
    return _system_get_os_type();
}

export function getOSArch(): string {
    return _system_get_os_arch();
}

export function getCwd(): Optional<string> {
    return _system_get_cwd();
}

export function getHomeDir(): Optional<string> {
    return _system_get_home_dir();
}

export function getTempDir(): string {
    return _system_get_temp_dir();
}

export function getHostname(): Optional<string> {
    return _system_get_hostname();
}

export function cpuCount(): int {
    return _system_get_cpu_count();
}

export function totalMemory(): int64 {
    return _system_get_total_memory();
}

export function freeMemory(): int64 {
    return _system_get_free_memory();
}

export function pid(): int {
    return _system_get_pid();
}

export function uptime(): float {
    return _system_get_uptime();
}

/// Executes a shell command synchronously and returns its stdout (trimmed).
/// If stdout is empty, stderr is returned for easy error inspection.
export function exec(cmd: string): string {
    return _system_exec(cmd);
}

/// Executes a shell command synchronously.
/// Returns a 3-element array: [exitCode: int, stdout: string, stderr: string].
export function execFull(cmd: string): any[] {
    return _system_exec_full(cmd);
}

/// Spawns a child process asynchronously.
/// Returns the child PID (> 0) on success, or -1 on failure.
export function spawn(program: string, args: string[]): int {
    return _system_spawn(program, args);
}

/// Sends SIGTERM (graceful) or SIGKILL (force=true) to a process by PID.
/// Returns true if the signal was delivered successfully.
export function kill(pid: int, force: bool = false): bool {
    return _system_kill(pid, force);
}

/// Waits for a child process by PID and returns its exit code.
/// Returns -1 on failure, -2 if the process was killed by a signal.
export function waitFor(pid: int): int {
    return _system_wait(pid);
}

