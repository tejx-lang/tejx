export class Timeout {
    private handle: int;

    constructor(callback: () => void, ms: int64) {
        this.handle = _time_set_timeout(callback, ms);
    }

    cancel(): void {
        if (this.handle != 0) {
            _time_clear_timeout(this.handle);
            this.handle = 0;
        }
    }

    isActive(): bool {
        return this.handle != 0;
    }
}

export class Interval {
    private handle: int;

    constructor(callback: () => void, ms: int64) {
        this.handle = _time_set_interval(callback, ms);
    }

    cancel(): void {
        if (this.handle != 0) {
            _time_clear_interval(this.handle);
            this.handle = 0;
        }
    }

    isActive(): bool {
        return this.handle != 0;
    }
}
