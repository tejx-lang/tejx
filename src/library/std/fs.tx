import "./fs/internal.tx";

// ── Canonical File System Operations ─────────────────────────────────────────

export function exists(path: string): bool {
    return _fs_exists(path);
}

export function readFile(path: string): string {
    return _fs_read(path);
}

export function writeFile(path: string, content: string): bool {
    return _fs_write(path, content);
}

export function appendFile(path: string, content: string): bool {
    return _fs_append(path, content);
}

export function remove(path: string): bool {
    return _fs_remove(path);
}

export function unlink(path: string): bool {
    return _fs_remove(path);
}

export function mkdir(path: string): bool {
    return _fs_mkdir(path);
}

export function ensureDir(path: string): bool {
    return _fs_ensure_dir(path);
}

export function listDir(path: string): string[] {
    return _fs_readdir(path);
}

export function readdir(path: string): string[] {
    return _fs_readdir(path);
}

// ── fs Namespace ─────────────────────────────────────────────────────────────

export namespace fs {
    export function exists(path: string): bool {
        return _fs_exists(path);
    }

    export function readFile(path: string): string {
        return _fs_read(path);
    }

    export function writeFile(path: string, content: string): bool {
        return _fs_write(path, content);
    }

    export function appendFile(path: string, content: string): bool {
        return _fs_append(path, content);
    }

    export function remove(path: string): bool {
        return _fs_remove(path);
    }

    export function unlink(path: string): bool {
        return _fs_remove(path);
    }

    export function mkdir(path: string): bool {
        return _fs_mkdir(path);
    }

    export function ensureDir(path: string): bool {
        return _fs_ensure_dir(path);
    }

    export function listDir(path: string): string[] {
        return _fs_readdir(path);
    }

    export function readdir(path: string): string[] {
        return _fs_readdir(path);
    }
}
