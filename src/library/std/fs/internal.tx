extern function rt_fs_read(path: string): Optional<string>;
extern function rt_fs_write(path: string, content: string): int;
extern function rt_fs_append(path: string, content: string): int;
extern function rt_fs_exists(path: string): int;
extern function rt_fs_unlink(path: string): int;
extern function rt_fs_mkdir(path: string): int;
extern function rt_fs_readdir(path: string): Optional<string[]>;

function _fs_exists(path: string): bool {
    return rt_fs_exists(path) != 0;
}

function _fs_read(path: string): string {
    let content = rt_fs_read(path);
    if (content == None) {
        throw new Error("Failed to read file: " + path);
    }
    return content as string;
}

function _fs_write(path: string, content: string): bool {
    return rt_fs_write(path, content) == 1;
}

function _fs_append(path: string, content: string): bool {
    return rt_fs_append(path, content) == 1;
}

function _fs_remove(path: string): bool {
    return rt_fs_unlink(path) == 1;
}

function _fs_mkdir(path: string): bool {
    return rt_fs_mkdir(path) == 1;
}

function _fs_ensure_dir(path: string): bool {
    if (_fs_exists(path)) return true;
    return _fs_mkdir(path);
}

function _fs_readdir(path: string): string[] {
    let entries = rt_fs_readdir(path);
    if (entries == None) {
        throw new Error("Failed to read directory: " + path);
    }
    return entries as string[];
}

