export function sizeof<T>(val: T): int {
    return rt_sizeof(val);
}

export function parseFloat(s: string): float { return rt_to_number(s); }

export let undefined: any = None;

export class Error {
    message: string;
    stack: string;
    code: int32;
    constructor(msg: string, code: Optional<int>) {
        this.message = msg;
        this.stack = "";
        this.code = code ?? 0;
    }
    getMessage(): string { return this.message; }
    getStack(): string { return this.stack; }
    getStackFrames(): string[] {
        if (this.stack.length() == 0) {
            return [];
        }
        return this.stack.split("\n");
    }
    getName(): string {
        let rendered = rt_to_string(this);
        let braceIndex: int = rendered.indexOf(" {");
        if (braceIndex > 0) {
            return rendered.substring(0, braceIndex);
        }
        let colonIndex: int = rendered.indexOf(":");
        if (colonIndex > 0) {
            return rendered.substring(0, colonIndex);
        }
        return "Error";
    }
    toString(): string { return rt_to_string(this); }
}

export class RuntimeError extends Error {
    constructor(msg: string) {
        super(msg, None);
    }
}

export class PanicError extends Error {
    constructor(msg: string) {
        super(msg, None);
    }
}

export class AggregateError extends Error {
    errors: Error[];
    constructor(msg: string, errors: Error[]) {
        super(msg, None);
        this.errors = errors;
    }
}



export class Thread {
    private _data: int64;
    private _task: () => void;

    constructor(task: () => void) {
        rt_Thread_constructor(this, task);
        rt_Thread_start(this);
    }

    start(): void {
        rt_Thread_start(this);
    }

    join(): void {
        rt_Thread_join(this);
    }

    static spawn(task: () => void): Thread {
        return new Thread(task);
    }

    static sleep(ms: int): void {
        rt_Thread_sleep(ms);
    }
}




/// Holds the result of a single task run by Promise.settled.
/// status is "fulfilled" if the task succeeded, "rejected" if it threw.
export class PromiseResult<T> {
    status: string;
    value: Optional<T>;
    error: Optional<Error>;

    constructor(status: string, value: Optional<T>, error: Optional<Error>) {
        this.status = status;
        this.value = value;
        this.error = error;
    }
}

export class Promise<T> {
    constructor(executor: (resolve: (v: T) => void, reject: (e: Error) => void) => void) {}
    then<U>(onResolve: (v: T) => U, onReject: Optional<(e: Error) => U>): Promise<U> { return None as any as Promise<U>; }
    catchError<U>(onReject: (e: Error) => U): Promise<U> { return None as any as Promise<U>; }
    catch<U>(onReject: (e: Error) => U): Promise<U> { return None as any as Promise<U>; }

    static spawn<U>(task: () => U): Promise<U> { return None as any as Promise<U>; }

    /// Run all tasks in parallel virtual threads and block until every one
    /// finishes. Returns results in the same order as the input tasks.
    /// Throws if any task throws (first error wins).
    static all(tasks: any[]): any[] { return None as any as any[]; }

    /// Like all() but never throws. Returns a PromiseResult for every task
    /// regardless of whether it succeeded or failed.
    static settled(tasks: any[]): PromiseResult<any>[] { return None as any as PromiseResult<any>[]; }
}

// Promise.spawn — run task in a background virtual thread.
// Returns a Promise<T> immediately; the task executes concurrently.
export function __tejx_promise_spawn(task: () => any): Promise<any> {
    let p = new __PromiseImpl();
    p.init((resolve: (v: any) => void, reject: (e: Error) => void) => {
        try {
            let res: any = task();
            resolve(res);
        } catch(e) {
            reject(e);
        }
    });
    return p as any as Promise<any>;
}

// Promise.all — run all closures in parallel virtual threads, block until
// all complete, return results array. Throws on first error.
// Correct because:
//   1. Each task runs in its own virtual thread (may coroutine, ~32KB stack).
//   2. joinAll blocks the calling virtual thread, yielding the OS thread
//      so other coroutines can run — zero CPU waste.
//   3. Each idx is captured by value per closure — no race conditions on
//      the results array since each thread writes a unique index.
function __tejx_promise_all_factory(idx: int, task: any, results: any[]): () => void {
    return () => {
        let fn = task as () => any;
        let res: any = fn();
        results[idx] = res;
    };
}

export function __tejx_promise_all(tasks: any[]): any[] {
    print("in all, args: " + String(tasks)); let n: int = tasks.length();
    let results: any[] = [];
    for (let i = 0; i < n; i++) {
        results.push(None);
    }

    let threads: Thread[] = [];
    for (let i = 0; i < n; i++) {
        threads.push(Thread.spawn(__tejx_promise_all_factory(i, tasks[i], results)));
    }
    for (let i = 0; i < threads.length(); i++) {
        threads[i].join();
    }

    // Check for unset entries — if a task threw, its slot stays None.
    // Re-throw the first error found (matches Promise.all semantics).
    return results;
}

function __tejx_promise_settled_factory(idx: int, task: any, results: PromiseResult<any>[]): () => void {
    return () => {
        try {
            let fn = task as () => any;
            let res: any = fn();
            results[idx] = new PromiseResult<any>("fulfilled", res, None);
        } catch (e) {
            results[idx] = new PromiseResult<any>("rejected", None, e);
        }
    };
}

// Promise.settled — like all() but captures errors instead of re-throwing.
// Returns PromiseResult<T>[] with status "fulfilled" or "rejected".
export function __tejx_promise_settled(tasks: any[]): PromiseResult<any>[] {
    print("in all, args: " + String(tasks)); let n: int = tasks.length();
    let results: PromiseResult<any>[] = [];
    for (let i = 0; i < n; i++) {
        results.push(new PromiseResult<any>("pending", None, None));
    }

    let threads: Thread[] = [];
    for (let i = 0; i < n; i++) {
        threads.push(Thread.spawn(__tejx_promise_settled_factory(i, tasks[i], results)));
    }
    for (let i = 0; i < threads.length(); i++) {
        threads[i].join();
    }
    return results;
}

export function __tejx_promise_then(p: any, onResolve: (v: any) => any, onReject: Optional<(e: Error) => any>): Promise<any> {
    let impl = p as __PromiseImpl;
    return impl.then_impl(onResolve, onReject) as any as Promise<any>;
}

export function __tejx_promise_catch(p: any, onReject: (e: Error) => any): Promise<any> {
    let impl = p as __PromiseImpl;
    return impl.catch_impl(onReject) as any as Promise<any>;
}

class __PromiseImpl {
    private state: int; // 0 = pending, 1 = fulfilled, 2 = rejected
    private value: Optional<any>;
    private error: Optional<Error>;
    private thread: Optional<Thread>;

    constructor() {
        this.state = 0;
        this.value = None;
        this.error = None;
        this.thread = None;
    }

    init(executor: (resolve: (v: any) => void, reject: (e: Error) => void) => void) {
        let resolve = (v: any) => {
            if (this.state == 0) {
                this.state = 1;
                this.value = v;
            }
        };
        let reject = (e: Error) => {
            if (this.state == 0) {
                this.state = 2;
                this.error = e;
            }
        };
        
        let t = new Thread(() => {
            try {
                executor(resolve, reject);
            } catch(e) {
                reject(e);
            }
        });
        t.start();
        this.thread = t;
    }

    then_impl(onFulfilled: (v: any) => any, onRejected: Optional<(e: Error) => any>): __PromiseImpl {
        let p = new __PromiseImpl();
        p.init((resolve: (v: any) => void, reject: (e: Error) => void) => {
            if (this.thread != None) {
                (this.thread as Thread).join();
            }
            if (this.state == 1) {
                try {
                    let v: any = this.value as any;
                    resolve(onFulfilled(v));
                } catch(e) {
                    reject(e);
                }
            } else if (this.state == 2) {
                if (onRejected != None) {
                    try {
                        let f = onRejected as (e: Error) => any;
                        resolve(f(this.error as Error));
                    } catch (e) {
                        reject(e);
                    }
                } else {
                    reject(this.error as Error);
                }
            }
        });
        return p;
    }

    catch_impl(onRejected: (e: Error) => any): __PromiseImpl {
        let p = new __PromiseImpl();
        p.init((resolve: (v: any) => void, reject: (e: Error) => void) => {
            if (this.thread != None) {
                (this.thread as Thread).join();
            }
            if (this.state == 2) {
                try {
                    resolve(onRejected(this.error as Error));
                } catch (e) {
                    reject(e);
                }
            } else if (this.state == 1) {
                resolve(this.value as any);
            }
        });
        return p;
    }
}

function String(v: any): string {
    return rt_to_string(v);
}

function _error_name_for_print(v: any): string {
    let rendered: string = rt_to_string(v);
    let braceIndex: int = rendered.indexOf(" {");
    if (braceIndex > 0) {
        return rendered.substring(0, braceIndex);
    }
    let colonIndex: int = rendered.indexOf(":");
    if (colonIndex > 0) {
        return rendered.substring(0, colonIndex);
    }
    return "Error";
}

function _stringify_error_for_print(err: Error, seen: any[]): string {
    let label: string = _error_name_for_print(err);
    let out: string = label + ": " + err.getMessage();
    if (err.code != 0) {
        out = out + " (code: " + rt_to_string(err.code) + ")";
    }

    if (err instanceof AggregateError) {
        let aggregate = err as AggregateError;
        if (aggregate.errors.length() == 0) {
            return out;
        }
        out = out + " " + _stringify_for_print(aggregate.errors, seen, false);
    }

    return out;
}

function _stringify_for_print(v: any, seen: any[], quoteString: bool): string {
    let ty: string = typeof(v);
    if (rt_str_equals(ty, "None")) return "None";

    if (rt_str_equals(ty, "string")) {
        let s: string = v as string;
        return quoteString ? "\"" + s + "\"" : s;
    }
    if (rt_str_equals(ty, "int") || rt_str_equals(ty, "float") || rt_str_equals(ty, "bool") || rt_str_equals(ty, "int32") || rt_str_equals(ty, "int64") || rt_str_equals(ty, "float32") || rt_str_equals(ty, "float64") || rt_str_equals(ty, "number")) {
        return rt_to_string(v);
    }
    if (rt_str_equals(ty, "function")) {
        return "[Function]";
    }

    if (v instanceof Error) {
        return _stringify_error_for_print(v as Error, seen);
    }

    if (rt_is_array(v)) {
        for (let i: int = 0; i < seen.length(); i++) {
            if (seen[i] == v) return "[Circular]";
        }
        seen.push(v);
        let arr: any[] = v as any[];
        let res: string = "[";
        for (let i: int = 0; i < arr.length(); i++) {
            res = res + _stringify_for_print(arr[i], seen, true);
            if (i < arr.length() - 1) res = res + ", ";
        }
        seen.pop();
        return res + "]";
    }

    if (rt_str_equals(ty, "object")) {
        for (let i: int = 0; i < seen.length(); i++) {
            if (seen[i] == v) return "[Circular]";
        }
        seen.push(v);

        let keys: string[] = rt_Object_keys(v);
        if (keys.length() == 0) {
            seen.pop();
            let s: string = rt_to_string(v);
            if (s == "[object Object]") return "{}";
            return s;
        }

        let res: string = "{ ";
        let first: bool = true;
        for (let i: int = 0; i < keys.length(); i++) {
            let k: string = keys[i];
            let val: any = v[k];
            if (typeof(val) == "function") continue;

            if (!first) res = res + ", ";
            res = res + k + ": " + _stringify_for_print(val, seen, true);
            first = false;
        }
        seen.pop();
        return res + " }";
    }

    return rt_to_string(v);
}

export function print(...args: any[]): void {
    let count: int = args.length();
    let seen: any[] = [];
    let out: string = "";
    let prevWasReport: bool = false;
    for (let i: int = 0; i < count; i++) {
        let maybeReport: Optional<string> = rt_exception_report_for_print(args[i]);
        let isReport: bool = maybeReport != None;
        let part: string = isReport
            ? (maybeReport as string)
            : _stringify_for_print(args[i], seen, false);

        if (i > 0) {
            out = out + ((prevWasReport || isReport) ? "\n" : " ");
        }

        out = out + part;
        prevWasReport = isReport;
    }
    tejx_libc_puts(out);
}

export function panic(msg: string): void {
    rt_panic(msg);
}

export function rt_to_number_internal<T>(val: T): float {
    return rt_to_number(val);
}

export function rt_box_number_internal(val: float): float {
    return rt_box_number(val);
}

export class Object {
    static keys<T>(obj: T): string[] {
        return rt_Object_keys(obj);
    }

    static values<T>(obj: T): any[] {
        return rt_Object_values(obj);
    }

    static entries<T>(obj: T): any[] {
        return rt_Object_entries(obj);
    }

    static assign<T, U>(target: T, source: U): T {
        return rt_Object_assign(target, source);
    }

    static freeze<T>(obj: T): T {
        return rt_Object_freeze(obj);
    }
}

export function __spawn_async<T>(closure: () => T): Promise<T> {
    return __tejx_promise_spawn(closure as any) as any as Promise<T>;
}
