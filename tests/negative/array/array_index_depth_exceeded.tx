// EXPECTED: COMPILE_ERROR
// Description: Indexing beyond array dimensionality or indexing non-array types

function main() {
    // 1. Indexing 1D array with two indices
    let arr: int[] = [1, 2];
    let x = arr[0][0];

    // 2. Indexing 2D array with three indices
    let m: int[2][2];
    let y = m[0][0][0];

    // 3. Indexing a scalar integer
    let n: int = 42;
    let z = n[0];

    // 4. Assigning into an index beyond array depth
    let grid: int[2][2];
    grid[0][0][0] = 99;
}
