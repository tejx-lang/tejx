// tests/timer_test.tx
import { setTimeout, setInterval, clearInterval, clearTimeout } from "std:time";
import { Atomic, sleep } from "std:thread";
import { assert_eq_int, assert_true } from "./utils.tx";

function main(): void {
    print("Starting timers...");

    let timeoutCount = new Atomic(0);
    let intervalCount = new Atomic(0);

    let timeoutId = setTimeout(() => {
        timeoutCount.increment();
        print("Timeout executed!");
    }, 80);

    let intervalId = setInterval(() => {
        intervalCount.increment();
        print("Interval executed!");
    }, 30);

    sleep(170);
    clearInterval(intervalId);
    clearTimeout(timeoutId);

    let intervalCountAfterClear = intervalCount.load();
    sleep(90);

    assert_eq_int(1, timeoutCount.load(), "setTimeout fires exactly once");
    assert_true(intervalCountAfterClear >= 2, "setInterval fires before clearInterval");
    assert_eq_int(intervalCountAfterClear, intervalCount.load(), "clearInterval stops future ticks");
    print("Interval cleared.");
    print("Timers test complete.");
}
