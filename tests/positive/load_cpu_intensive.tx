// CPU-Intensive Load Test
// ========================
// Heavy CPU-bound workloads that exercise the compiler's code generation
// correctness under computational pressure while GC is active:
// 1. Fibonacci (recursive + iterative)
// 2. Sorting algorithms (merge sort, quicksort-like)
// 3. Matrix operations
// 4. Prime sieve
// 5. String processing
// All results are verified for correctness to ensure GC doesn't corrupt computation.

import { assert_eq_int, assert_true, assert_eq_string } from "./utils.tx";
import { collect } from "std:gc";
import { now } from "std:time";

// === Fibonacci ===
function fib_recursive(n: int): int {
    if (n <= 0) return 0;
    if (n == 1) return 1;
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

function fib_iterative(n: int): int {
    if (n <= 0) return 0;
    if (n == 1) return 1;
    let a = 0;
    let b = 1;
    for (let i = 2; i <= n; i++) {
        let temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

function test_fibonacci() {
    print("--- CPU: Fibonacci ---");
    let start = now();

    // Recursive (moderate depth to avoid timeout)
    assert_eq_int(0, fib_recursive(0), "fib(0)");
    assert_eq_int(1, fib_recursive(1), "fib(1)");
    assert_eq_int(55, fib_recursive(10), "fib(10)");
    assert_eq_int(6765, fib_recursive(20), "fib(20)");
    assert_eq_int(832040, fib_recursive(30), "fib(30)");

    // Iterative (can go higher)
    assert_eq_int(832040, fib_iterative(30), "fib_iter(30)");
    assert_eq_int(102334155, fib_iterative(40), "fib_iter(40)");

    // Cross-verify
    for (let n = 0; n <= 25; n++) {
        assert_eq_int(fib_recursive(n), fib_iterative(n), "fib cross-check n=" + n);
    }

    let elapsed = now() - start;
    print("  Fibonacci time: " + elapsed + "ms");
}

// === Merge Sort ===
function mergeSort(arr: int[]): int[] {
    if (arr.length() <= 1) return arr;

    let mid = arr.length() / 2;
    let left: int[] = [];
    let right: int[] = [];

    for (let i = 0; i < mid; i++) {
        left.push(arr[i]);
    }
    for (let i = mid; i < arr.length(); i++) {
        right.push(arr[i]);
    }

    left = mergeSort(left);
    right = mergeSort(right);
    return merge(left, right);
}

function merge(left: int[], right: int[]): int[] {
    let result: int[] = [];
    let i = 0;
    let j = 0;

    while (i < left.length() && j < right.length()) {
        if (left[i] <= right[j]) {
            result.push(left[i]);
            i = i + 1;
        } else {
            result.push(right[j]);
            j = j + 1;
        }
    }

    while (i < left.length()) {
        result.push(left[i]);
        i = i + 1;
    }
    while (j < right.length()) {
        result.push(right[j]);
        j = j + 1;
    }

    return result;
}

function isSorted(arr: int[]): bool {
    for (let i = 1; i < arr.length(); i++) {
        if (arr[i] < arr[i - 1]) return false;
    }
    return true;
}

function test_merge_sort() {
    print("--- CPU: Merge Sort ---");
    let start = now();

    // Sort 5000 elements in reverse order
    let arr: int[] = [];
    for (let i = 5000; i > 0; i--) {
        arr.push(i);
    }

    let sorted = mergeSort(arr);
    assert_eq_int(5000, sorted.length(), "Sorted array length");
    assert_true(isSorted(sorted), "Array is sorted");
    assert_eq_int(1, sorted[0], "First element is 1");
    assert_eq_int(5000, sorted[4999], "Last element is 5000");

    // Sort already sorted
    let resorted = mergeSort(sorted);
    assert_true(isSorted(resorted), "Re-sorted array is sorted");

    // Sort single element
    let single = mergeSort([42]);
    assert_eq_int(1, single.length(), "Single element length");
    assert_eq_int(42, single[0], "Single element value");

    // Sort empty
    let empty = mergeSort([]);
    assert_eq_int(0, empty.length(), "Empty sort");

    collect();

    let elapsed = now() - start;
    print("  Merge sort time: " + elapsed + "ms");
}

// === Bubble Sort (O(n^2) — CPU stress) ===
function bubbleSort(arr: int[]): void {
    let n = arr.length();
    for (let i = 0; i < n - 1; i++) {
        for (let j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                let temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

function test_bubble_sort() {
    print("--- CPU: Bubble Sort ---");
    let start = now();

    let arr: int[] = [];
    for (let i = 2000; i > 0; i--) {
        arr.push(i);
    }

    bubbleSort(arr);
    assert_eq_int(2000, arr.length(), "Bubble sort length");
    assert_true(isSorted(arr), "Bubble sorted correctly");
    assert_eq_int(1, arr[0], "First element");
    assert_eq_int(2000, arr[1999], "Last element");

    let elapsed = now() - start;
    print("  Bubble sort 2000 elements: " + elapsed + "ms");
}

// === Matrix Multiplication ===
function matMul(a: int[][], b: int[][], n: int): int[][] {
    let result: int[][] = [];
    for (let i = 0; i < n; i++) {
        let row: int[] = [];
        for (let j = 0; j < n; j++) {
            let sum = 0;
            for (let k = 0; k < n; k++) {
                sum = sum + a[i][k] * b[k][j];
            }
            row.push(sum);
        }
        result.push(row);
    }
    return result;
}

function test_matrix_multiply() {
    print("--- CPU: Matrix Multiplication ---");
    let start = now();

    let n = 50;

    // Identity matrix
    let identity: int[][] = [];
    let matrix: int[][] = [];
    for (let i = 0; i < n; i++) {
        let iRow: int[] = [];
        let mRow: int[] = [];
        for (let j = 0; j < n; j++) {
            if (i == j) iRow.push(1); else iRow.push(0);
            mRow.push(i * n + j + 1);
        }
        identity.push(iRow);
        matrix.push(mRow);
    }

    // M * I = M
    let result = matMul(matrix, identity, n);
    for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
            assert_eq_int(matrix[i][j], result[i][j], "M*I[" + i + "][" + j + "]");
        }
    }

    collect();

    // Square a small matrix and verify
    let small: int[][] = [[1, 2], [3, 4]];
    let sq = matMul(small, small, 2);
    assert_eq_int(7, sq[0][0], "2x2 square [0][0]");   // 1*1+2*3
    assert_eq_int(10, sq[0][1], "2x2 square [0][1]");  // 1*2+2*4
    assert_eq_int(15, sq[1][0], "2x2 square [1][0]");  // 3*1+4*3
    assert_eq_int(22, sq[1][1], "2x2 square [1][1]");  // 3*2+4*4

    let elapsed = now() - start;
    print("  Matrix multiply time: " + elapsed + "ms");
}

// === Prime Sieve ===
function sieve(limit: int): int {
    let isPrime: bool[] = [false, false];
    for (let i = 2; i <= limit; i++) {
        isPrime.push(true);
    }

    for (let p = 2; p * p <= limit; p++) {
        if (isPrime[p]) {
            for (let i = p * p; i <= limit; i += p) {
                isPrime[i] = false;
            }
        }
    }

    let count = 0;
    for (let i = 2; i <= limit; i++) {
        if (isPrime[i]) count = count + 1;
    }
    return count;
}

function test_prime_sieve() {
    print("--- CPU: Prime Sieve ---");
    let start = now();

    // Known values: π(100) = 25, π(1000) = 168, π(10000) = 1229, π(100000) = 9592
    assert_eq_int(25, sieve(100), "Primes up to 100");
    assert_eq_int(168, sieve(1000), "Primes up to 1000");
    assert_eq_int(1229, sieve(10000), "Primes up to 10000");
    assert_eq_int(9592, sieve(100000), "Primes up to 100000");

    collect();

    let elapsed = now() - start;
    print("  Prime sieve time: " + elapsed + "ms");
}

// === String Processing ===
function reverseString(s: string): string {
    let result = "";
    for (let i = s.length() - 1; i >= 0; i--) {
        result = result + s.substring(i, i + 1);
    }
    return result;
}

function isPalindrome(s: string): bool {
    return s == reverseString(s);
}

function test_string_processing() {
    print("--- CPU: String Processing ---");
    let start = now();

    // Reverse
    assert_eq_string("dcba", reverseString("abcd"), "Reverse abcd");
    assert_eq_string("", reverseString(""), "Reverse empty");
    assert_eq_string("a", reverseString("a"), "Reverse single");
    assert_eq_string("edcba", reverseString("abcde"), "Reverse abcde");

    // Palindrome check
    assert_true(isPalindrome("racecar"), "racecar is palindrome");
    assert_true(isPalindrome("abcba"), "abcba is palindrome");
    assert_true(isPalindrome("a"), "single char palindrome");
    assert_true(isPalindrome(""), "empty palindrome");
    assert_true(!isPalindrome("hello"), "hello is not palindrome");

    // Build large string and reverse
    let big = "";
    for (let i = 0; i < 500; i++) {
        big = big + "X";
    }
    let reversed = reverseString(big);
    assert_eq_int(500, reversed.length(), "Reversed big string length");
    assert_eq_string(big, reversed, "All-same-char string is palindrome-like");

    collect();

    let elapsed = now() - start;
    print("  String processing time: " + elapsed + "ms");
}

function main() {
    print("=== CPU INTENSIVE LOAD TEST START ===");
    test_fibonacci();
    test_merge_sort();
    test_bubble_sort();
    test_matrix_multiply();
    test_prime_sieve();
    test_string_processing();
    print("=== CPU INTENSIVE LOAD TEST COMPLETE ===");
}
