// ============================================================================
//  array_comprehensive.tx — Exhaustive Multi-Dimensional Array Tests
//  Covers: int, float, bool, string, struct (anonymous), class
//  Dimensions: 1D, 2D (all 4 combos), 3D (all 8 combos), 4D
//  Patterns: init, uninit, empty-init, push, assign, mutate, jagged, length
// ============================================================================

import { assert_eq_int, assert_eq_float, assert_eq_string, assert_true, assert_false } from "../utils.tx";

class Vec2 {
    x: int;
    y: int;
    constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

// ─── SECTION A: INT ─────────────────────────────────────────────────────────
function test_int_arrays() {
    print("===== INT ARRAYS =====");

    // ── 1D Fixed ──
    let i1f: int[4] = [10, 20, 30, 40];
    assert_eq_int(10, i1f[0], "int 1D fixed [0]");
    assert_eq_int(40, i1f[3], "int 1D fixed [3]");
    assert_eq_int(4, i1f.length, "int 1D fixed length");

    // 1D Fixed uninitialized
    let i1fu: int[3];
    assert_eq_int(0, i1fu[0], "int 1D fixed uninit [0] == 0");
    assert_eq_int(0, i1fu[2], "int 1D fixed uninit [2] == 0");
    i1fu[1] = 42;
    assert_eq_int(42, i1fu[1], "int 1D fixed uninit assign");

    // ── 1D Dynamic ──
    let i1d: int[] = [1, 2];
    i1d.push(3);
    assert_eq_int(3, i1d[2], "int 1D dyn push");
    assert_eq_int(3, i1d.length, "int 1D dyn length");

    // 1D Dynamic empty
    let i1de: int[] = [];
    assert_eq_int(0, i1de.length, "int 1D dyn empty length");
    i1de.push(99);
    assert_eq_int(99, i1de[0], "int 1D dyn empty push");

    // ── 2D Fixed×Fixed ──
    print("-- int 2D F×F --");
    let i2ff: int[2][3] = [[1,2],[3,4],[5,6]];
    assert_eq_int(1, i2ff[0][0], "int 2D F×F [0][0]");
    assert_eq_int(4, i2ff[1][1], "int 2D F×F [1][1]");
    assert_eq_int(6, i2ff[2][1], "int 2D F×F [2][1]");
    assert_eq_int(3, i2ff.length, "int 2D F×F outer length");
    assert_eq_int(2, i2ff[0].length, "int 2D F×F inner length");

    // 2D Fixed×Fixed uninitialized
    let i2ffu: int[2][3];
    assert_eq_int(0, i2ffu[0][0], "int 2D F×F uninit default");
    i2ffu[0][0] = 42; i2ffu[2][1] = 99;
    assert_eq_int(42, i2ffu[0][0], "int 2D F×F uninit assign [0][0]");
    assert_eq_int(99, i2ffu[2][1], "int 2D F×F uninit assign [2][1]");

    // ── 2D Dynamic×Dynamic ──
    print("-- int 2D D×D --");
    let i2dd: int[][] = [[1,2,3],[4,5]];
    assert_eq_int(3, i2dd[0][2], "int 2D D×D [0][2]");
    assert_eq_int(5, i2dd[1][1], "int 2D D×D [1][1]");
    assert_eq_int(2, i2dd.length, "int 2D D×D outer length");
    assert_eq_int(3, i2dd[0].length, "int 2D D×D inner[0] length");
    assert_eq_int(2, i2dd[1].length, "int 2D D×D inner[1] length (jagged)");

    // 2D D×D push
    let i2dd2: int[][] = [];
    i2dd2.push([10, 20]);
    i2dd2.push([30]);
    assert_eq_int(20, i2dd2[0][1], "int 2D D×D push [0][1]");
    assert_eq_int(30, i2dd2[1][0], "int 2D D×D push [1][0]");

    // ── 2D Fixed outer, Dynamic inner (int[][N]) ──
    print("-- int 2D FO-DI --");
    let i2fd: int[][2];
    assert_eq_int(2, i2fd.length, "int 2D FO-DI outer length");
    assert_eq_int(0, i2fd[0].length, "int 2D FO-DI inner starts empty");
    i2fd[0].push(100); i2fd[0].push(200);
    i2fd[1].push(300);
    assert_eq_int(100, i2fd[0][0], "int 2D FO-DI [0][0]");
    assert_eq_int(200, i2fd[0][1], "int 2D FO-DI [0][1]");
    assert_eq_int(300, i2fd[1][0], "int 2D FO-DI [1][0]");
    assert_eq_int(2, i2fd[0].length, "int 2D FO-DI inner[0] length after push");

    // ── 2D Dynamic outer, Fixed inner (int[N][]) ──
    print("-- int 2D DO-FI --");
    let i2df: int[2][] = [[10,20],[30,40]];
    assert_eq_int(10, i2df[0][0], "int 2D DO-FI [0][0]");
    assert_eq_int(40, i2df[1][1], "int 2D DO-FI [1][1]");
    assert_eq_int(2, i2df.length, "int 2D DO-FI outer length");

    let i2df2: int[2][] = [];
    i2df2.push([5,6]);
    i2df2.push([7,8]);
    assert_eq_int(5, i2df2[0][0], "int 2D DO-FI push [0][0]");
    assert_eq_int(8, i2df2[1][1], "int 2D DO-FI push [1][1]");

    // ── 3D: All Fixed ──
    print("-- int 3D FFF --");
    let i3fff: int[2][3][4];
    assert_eq_int(4, i3fff.length, "int 3D FFF outer length");
    assert_eq_int(3, i3fff[0].length, "int 3D FFF mid length");
    assert_eq_int(2, i3fff[0][0].length, "int 3D FFF inner length");
    i3fff[0][0][0] = 1; i3fff[3][2][1] = 999;
    assert_eq_int(1, i3fff[0][0][0], "int 3D FFF assign [0][0][0]");
    assert_eq_int(999, i3fff[3][2][1], "int 3D FFF assign [3][2][1]");

    // 3D: All Dynamic
    print("-- int 3D DDD --");
    let i3ddd: int[][][] = [[[1,2],[3]],[[4,5,6]]];
    assert_eq_int(2, i3ddd[0][0][1], "int 3D DDD [0][0][1]");
    assert_eq_int(3, i3ddd[0][1][0], "int 3D DDD [0][1][0]");
    assert_eq_int(6, i3ddd[1][0][2], "int 3D DDD [1][0][2]");

    // 3D: Fixed outer, rest dynamic (int[][][N])
    print("-- int 3D FO --");
    let i3fdd: int[][][2];
    i3fdd[0].push([1,2]);
    i3fdd[1].push([3,4]);
    assert_eq_int(1, i3fdd[0][0][0], "int 3D FO [0][0][0]");
    assert_eq_int(4, i3fdd[1][0][1], "int 3D FO [1][0][1]");

    // 3D: Dynamic outer, fixed mid & inner (int[2][3][])
    print("-- int 3D DO-FMI --");
    let i3dff: int[2][3][] = [[[1,2],[3,4],[5,6]]];
    assert_eq_int(1, i3dff[0][0][0], "int 3D DO-FMI [0][0][0]");
    assert_eq_int(6, i3dff[0][2][1], "int 3D DO-FMI [0][2][1]");

    // ── 4D: All Fixed ──
    print("-- int 4D FFFF --");
    let i4: int[2][2][2][2];
    assert_eq_int(2, i4.length, "int 4D outer length");
    assert_eq_int(2, i4[0].length, "int 4D [0] length");
    assert_eq_int(2, i4[0][0].length, "int 4D [0][0] length");
    assert_eq_int(2, i4[0][0][0].length, "int 4D [0][0][0] length");
    i4[0][0][0][0] = 1; i4[1][1][1][1] = 16; i4[0][1][0][1] = 77;
    assert_eq_int(1, i4[0][0][0][0], "int 4D [0][0][0][0]");
    assert_eq_int(16, i4[1][1][1][1], "int 4D [1][1][1][1]");
    assert_eq_int(77, i4[0][1][0][1], "int 4D [0][1][0][1]");

    // 4D: Mixed (int[][2][2][3]) — outer fixed(3), mid fixed(2×2), inner dynamic
    print("-- int 4D mixed --");
    let i4m: int[][2][2][3];
    i4m[0][0][0].push(111);
    i4m[2][1][1].push(999);
    assert_eq_int(111, i4m[0][0][0][0], "int 4D mixed [0][0][0][0]");
    assert_eq_int(999, i4m[2][1][1][0], "int 4D mixed [2][1][1][0]");
}

// ─── SECTION B: FLOAT ───────────────────────────────────────────────────────
function test_float_arrays() {
    print("===== FLOAT ARRAYS =====");

    // 1D
    let f1f: float[2] = [1.5, 2.5];
    assert_eq_float(1.5, f1f[0], "float 1D fixed [0]");
    assert_eq_float(2.5, f1f[1], "float 1D fixed [1]");

    let f1d: float[] = [];
    f1d.push(3.14); f1d.push(2.71);
    assert_eq_float(3.14, f1d[0], "float 1D dyn push [0]");
    assert_eq_int(2, f1d.length, "float 1D dyn length");

    // 2D F×F
    print("-- float 2D F×F --");
    let f2ff: float[2][2] = [[1.1, 2.2], [3.3, 4.4]];
    assert_eq_float(1.1, f2ff[0][0], "float 2D F×F [0][0]");
    assert_eq_float(4.4, f2ff[1][1], "float 2D F×F [1][1]");

    // 2D D×D
    let f2dd: float[][] = [[0.1, 0.2], [0.3]];
    assert_eq_float(0.2, f2dd[0][1], "float 2D D×D [0][1]");
    assert_eq_float(0.3, f2dd[1][0], "float 2D D×D [1][0]");

    // 2D FO-DI
    print("-- float 2D FO-DI --");
    let f2fd: float[][2];
    f2fd[0].push(1.1); f2fd[0].push(2.2);
    f2fd[1].push(3.3);
    assert_eq_float(1.1, f2fd[0][0], "float 2D FO-DI [0][0]");
    assert_eq_float(2.2, f2fd[0][1], "float 2D FO-DI [0][1]");
    assert_eq_float(3.3, f2fd[1][0], "float 2D FO-DI [1][0]");

    // 2D DO-FI
    let f2df: float[2][] = [[10.5, 20.5]];
    assert_eq_float(10.5, f2df[0][0], "float 2D DO-FI [0][0]");
    assert_eq_float(20.5, f2df[0][1], "float 2D DO-FI [0][1]");

    // 3D all fixed
    print("-- float 3D FFF --");
    let f3: float[2][2][2];
    f3[0][0][0] = 1.1; f3[1][1][1] = 8.8;
    assert_eq_float(1.1, f3[0][0][0], "float 3D FFF [0][0][0]");
    assert_eq_float(8.8, f3[1][1][1], "float 3D FFF [1][1][1]");

    // 3D all dynamic
    let f3d: float[][][] = [[[1.1, 2.2]], [[3.3]]];
    assert_eq_float(1.1, f3d[0][0][0], "float 3D DDD [0][0][0]");
    assert_eq_float(2.2, f3d[0][0][1], "float 3D DDD [0][0][1]");
    assert_eq_float(3.3, f3d[1][0][0], "float 3D DDD [1][0][0]");
}

// ─── SECTION C: BOOL ────────────────────────────────────────────────────────
function test_bool_arrays() {
    print("===== BOOL ARRAYS =====");

    // 1D
    let b1f: bool[3] = [true, false, true];
    assert_true(b1f[0], "bool 1D fixed [0]");
    assert_false(b1f[1], "bool 1D fixed [1]");
    assert_true(b1f[2], "bool 1D fixed [2]");

    let b1d: bool[] = [false];
    b1d.push(true);
    assert_false(b1d[0], "bool 1D dyn [0]");
    assert_true(b1d[1], "bool 1D dyn push [1]");

    // 2D F×F
    print("-- bool 2D F×F --");
    let b2ff: bool[2][2] = [[true, false], [false, true]];
    assert_true(b2ff[0][0], "bool 2D F×F [0][0]");
    assert_false(b2ff[0][1], "bool 2D F×F [0][1]");
    assert_false(b2ff[1][0], "bool 2D F×F [1][0]");
    assert_true(b2ff[1][1], "bool 2D F×F [1][1]");

    // 2D D×D
    let b2dd: bool[][] = [[true, true], [false]];
    assert_true(b2dd[0][1], "bool 2D D×D [0][1]");
    assert_false(b2dd[1][0], "bool 2D D×D [1][0]");

    // 2D FO-DI
    print("-- bool 2D FO-DI --");
    let b2fd: bool[][2];
    b2fd[0].push(true); b2fd[0].push(false);
    b2fd[1].push(true);
    assert_true(b2fd[0][0], "bool 2D FO-DI [0][0]");
    assert_false(b2fd[0][1], "bool 2D FO-DI [0][1]");
    assert_true(b2fd[1][0], "bool 2D FO-DI [1][0]");

    // 2D DO-FI
    let b2df: bool[2][] = [[true, false]];
    assert_true(b2df[0][0], "bool 2D DO-FI [0][0]");
    assert_false(b2df[0][1], "bool 2D DO-FI [0][1]");

    // 3D all fixed
    print("-- bool 3D FFF --");
    let b3: bool[2][2][2];
    b3[0][0][0] = true; b3[1][1][1] = true;
    assert_true(b3[0][0][0], "bool 3D FFF [0][0][0]");
    assert_false(b3[0][0][1], "bool 3D FFF uninit [0][0][1]");
    assert_true(b3[1][1][1], "bool 3D FFF [1][1][1]");

    // 3D all dynamic
    let b3d: bool[][][] = [[[true, false]], [[true]]];
    assert_true(b3d[0][0][0], "bool 3D DDD [0][0][0]");
    assert_false(b3d[0][0][1], "bool 3D DDD [0][0][1]");
    assert_true(b3d[1][0][0], "bool 3D DDD [1][0][0]");
}

// ─── SECTION D: STRING ──────────────────────────────────────────────────────
function test_string_arrays() {
    print("===== STRING ARRAYS =====");

    // 1D
    let s1f: string[2] = ["hello", "world"];
    assert_eq_string("hello", s1f[0], "string 1D fixed [0]");
    assert_eq_string("world", s1f[1], "string 1D fixed [1]");

    let s1d: string[] = [];
    s1d.push("foo"); s1d.push("bar");
    assert_eq_string("foo", s1d[0], "string 1D dyn push [0]");
    assert_eq_string("bar", s1d[1], "string 1D dyn push [1]");

    // 2D F×F
    print("-- string 2D F×F --");
    let s2ff: string[2][2] = [["a", "b"], ["c", "d"]];
    assert_eq_string("a", s2ff[0][0], "string 2D F×F [0][0]");
    assert_eq_string("d", s2ff[1][1], "string 2D F×F [1][1]");

    // 2D D×D
    let s2dd: string[][] = [["x", "y", "z"], ["w"]];
    assert_eq_string("z", s2dd[0][2], "string 2D D×D [0][2]");
    assert_eq_string("w", s2dd[1][0], "string 2D D×D [1][0]");
    assert_eq_int(3, s2dd[0].length, "string 2D D×D jagged [0].length");
    assert_eq_int(1, s2dd[1].length, "string 2D D×D jagged [1].length");

    // 2D FO-DI
    print("-- string 2D FO-DI --");
    let s2fd: string[][2];
    s2fd[0].push("alpha"); s2fd[0].push("beta");
    s2fd[1].push("gamma");
    assert_eq_string("alpha", s2fd[0][0], "string 2D FO-DI [0][0]");
    assert_eq_string("beta", s2fd[0][1], "string 2D FO-DI [0][1]");
    assert_eq_string("gamma", s2fd[1][0], "string 2D FO-DI [1][0]");

    // 2D DO-FI
    let s2df: string[2][] = [["one", "two"]];
    assert_eq_string("one", s2df[0][0], "string 2D DO-FI [0][0]");
    assert_eq_string("two", s2df[0][1], "string 2D DO-FI [0][1]");

    // 3D all fixed
    print("-- string 3D FFF --");
    let s3: string[2][2][2];
    s3[0][0][0] = "a"; s3[1][1][1] = "h";
    assert_eq_string("a", s3[0][0][0], "string 3D FFF [0][0][0]");
    assert_eq_string("h", s3[1][1][1], "string 3D FFF [1][1][1]");

    // 3D all dynamic
    let s3d: string[][][] = [[["a", "b"]], [["c"]]];
    assert_eq_string("a", s3d[0][0][0], "string 3D DDD [0][0][0]");
    assert_eq_string("b", s3d[0][0][1], "string 3D DDD [0][0][1]");
    assert_eq_string("c", s3d[1][0][0], "string 3D DDD [1][0][0]");
}

// ─── SECTION E: ANONYMOUS STRUCT ────────────────────────────────────────────
function test_struct_arrays() {
    print("===== STRUCT (anonymous) ARRAYS =====");

    // 1D fixed
    let st1f: { x: int, y: int }[2] = [{ x: 1, y: 2 }, { x: 3, y: 4 }];
    assert_eq_int(1, st1f[0].x, "struct 1D fixed [0].x");
    assert_eq_int(4, st1f[1].y, "struct 1D fixed [1].y");

    // 1D dynamic + push
    let st1d: { x: int, y: int }[] = [{ x: 10, y: 20 }];
    st1d.push({ x: 30, y: 40 });
    assert_eq_int(10, st1d[0].x, "struct 1D dyn [0].x");
    assert_eq_int(40, st1d[1].y, "struct 1D dyn push [1].y");
    assert_eq_int(2, st1d.length, "struct 1D dyn length");

    // 2D F×F
    print("-- struct 2D F×F --");
    let st2ff: { x: int, y: int }[2][2] = [
        [{ x: 1, y: 2 }, { x: 3, y: 4 }],
        [{ x: 5, y: 6 }, { x: 7, y: 8 }]
    ];
    assert_eq_int(1, st2ff[0][0].x, "struct 2D F×F [0][0].x");
    assert_eq_int(8, st2ff[1][1].y, "struct 2D F×F [1][1].y");

    // 2D D×D
    let st2dd: { x: int, y: int }[][] = [
        [{ x: 10, y: 20 }],
        [{ x: 30, y: 40 }, { x: 50, y: 60 }]
    ];
    assert_eq_int(10, st2dd[0][0].x, "struct 2D D×D [0][0].x");
    assert_eq_int(60, st2dd[1][1].y, "struct 2D D×D [1][1].y");

    // 2D FO-DI + push
    print("-- struct 2D FO-DI --");
    let st2fd: { x: int, y: int }[][2];
    st2fd[0].push({ x: 100, y: 200 });
    st2fd[1].push({ x: 300, y: 400 });
    assert_eq_int(100, st2fd[0][0].x, "struct 2D FO-DI push [0][0].x");
    assert_eq_int(200, st2fd[0][0].y, "struct 2D FO-DI push [0][0].y");
    assert_eq_int(300, st2fd[1][0].x, "struct 2D FO-DI push [1][0].x");

    // 2D DO-FI
    let st2df: { x: int, y: int }[2][] = [[{ x: 1, y: 2 }, { x: 3, y: 4 }]];
    assert_eq_int(1, st2df[0][0].x, "struct 2D DO-FI [0][0].x");
    assert_eq_int(4, st2df[0][1].y, "struct 2D DO-FI [0][1].y");

    // 3D all fixed
    print("-- struct 3D FFF --");
    let st3: { x: int, y: int }[2][2][2];
    st3[0][0][0] = { x: 1, y: 2 };
    st3[1][1][1] = { x: 99, y: 100 };
    assert_eq_int(1, st3[0][0][0].x, "struct 3D FFF [0][0][0].x");
    assert_eq_int(100, st3[1][1][1].y, "struct 3D FFF [1][1][1].y");

    // 3D all dynamic
    let st3d: { x: int, y: int }[][][] = [
        [[{ x: 1, y: 2 }]],
        [[{ x: 3, y: 4 }, { x: 5, y: 6 }]]
    ];
    assert_eq_int(1, st3d[0][0][0].x, "struct 3D DDD [0][0][0].x");
    assert_eq_int(6, st3d[1][0][1].y, "struct 3D DDD [1][0][1].y");

    // 3D FO-DI
    print("-- struct 3D FO-DI --");
    let st3fd: { x: int, y: int }[][2][2];
    st3fd[0][0].push({ x: 111, y: 222 });
    st3fd[1][1].push({ x: 333, y: 444 });
    assert_eq_int(111, st3fd[0][0][0].x, "struct 3D FO-DI push [0][0][0].x");
    assert_eq_int(444, st3fd[1][1][0].y, "struct 3D FO-DI push [1][1][0].y");
}

// ─── SECTION F: CLASS ───────────────────────────────────────────────────────
function test_class_arrays() {
    print("===== CLASS (Vec2) ARRAYS =====");

    // 1D fixed
    let c1f: Vec2[2] = [new Vec2(1, 2), new Vec2(3, 4)];
    assert_eq_int(1, c1f[0].x, "class 1D fixed [0].x");
    assert_eq_int(4, c1f[1].y, "class 1D fixed [1].y");

    // 1D dynamic + push
    let c1d: Vec2[] = [new Vec2(10, 20)];
    c1d.push(new Vec2(30, 40));
    assert_eq_int(10, c1d[0].x, "class 1D dyn [0].x");
    assert_eq_int(40, c1d[1].y, "class 1D dyn push [1].y");

    // 2D F×F
    print("-- class 2D F×F --");
    let c2ff: Vec2[2][2] = [
        [new Vec2(1, 2), new Vec2(3, 4)],
        [new Vec2(5, 6), new Vec2(7, 8)]
    ];
    assert_eq_int(1, c2ff[0][0].x, "class 2D F×F [0][0].x");
    assert_eq_int(8, c2ff[1][1].y, "class 2D F×F [1][1].y");

    // 2D D×D
    let c2dd: Vec2[][] = [
        [new Vec2(10, 20)],
        [new Vec2(30, 40), new Vec2(50, 60)]
    ];
    assert_eq_int(10, c2dd[0][0].x, "class 2D D×D [0][0].x");
    assert_eq_int(60, c2dd[1][1].y, "class 2D D×D [1][1].y");

    // 2D FO-DI + push
    print("-- class 2D FO-DI --");
    let c2fd: Vec2[][2];
    c2fd[0].push(new Vec2(100, 200));
    c2fd[1].push(new Vec2(300, 400));
    assert_eq_int(100, c2fd[0][0].x, "class 2D FO-DI push [0][0].x");
    assert_eq_int(200, c2fd[0][0].y, "class 2D FO-DI push [0][0].y");
    assert_eq_int(300, c2fd[1][0].x, "class 2D FO-DI push [1][0].x");

    // 2D DO-FI
    let c2df: Vec2[2][] = [[new Vec2(1, 2), new Vec2(3, 4)]];
    assert_eq_int(1, c2df[0][0].x, "class 2D DO-FI [0][0].x");
    assert_eq_int(4, c2df[0][1].y, "class 2D DO-FI [0][1].y");

    // 3D all fixed
    print("-- class 3D FFF --");
    let c3: Vec2[2][2][2];
    c3[0][0][0] = new Vec2(1, 2);
    c3[1][1][1] = new Vec2(99, 100);
    assert_eq_int(1, c3[0][0][0].x, "class 3D FFF [0][0][0].x");
    assert_eq_int(100, c3[1][1][1].y, "class 3D FFF [1][1][1].y");

    // 3D all dynamic
    let c3d: Vec2[][][] = [
        [[new Vec2(1, 2)]],
        [[new Vec2(3, 4), new Vec2(5, 6)]]
    ];
    assert_eq_int(1, c3d[0][0][0].x, "class 3D DDD [0][0][0].x");
    assert_eq_int(6, c3d[1][0][1].y, "class 3D DDD [1][0][1].y");

    // 3D FO-DI + push
    print("-- class 3D FO-DI --");
    let c3fd: Vec2[][2][2];
    c3fd[0][0].push(new Vec2(11, 22));
    c3fd[1][1].push(new Vec2(33, 44));
    assert_eq_int(11, c3fd[0][0][0].x, "class 3D FO-DI push [0][0][0].x");
    assert_eq_int(44, c3fd[1][1][0].y, "class 3D FO-DI push [1][1][0].y");
}

// ─── SECTION G: MUTATION & EDGE CASES ───────────────────────────────────────
function test_mutations_and_edges() {
    print("===== MUTATION & EDGE CASES =====");

    // Overwrite in 2D fixed
    let m: int[3][3];
    m[0][0] = 1; m[1][1] = 5; m[2][2] = 9;
    assert_eq_int(1, m[0][0], "mutation diagonal [0][0]");
    assert_eq_int(5, m[1][1], "mutation diagonal [1][1]");
    assert_eq_int(9, m[2][2], "mutation diagonal [2][2]");
    m[0][0] = 100;
    assert_eq_int(100, m[0][0], "mutation overwrite [0][0]");

    // Push struct to dynamic inner of fixed outer
    let ms: { v: int }[][3];
    ms[0].push({ v: 10 }); ms[0].push({ v: 20 });
    ms[1].push({ v: 30 });
    ms[2].push({ v: 40 });
    assert_eq_int(10, ms[0][0].v, "mutation struct push [0][0].v");
    assert_eq_int(20, ms[0][1].v, "mutation struct push [0][1].v");
    assert_eq_int(30, ms[1][0].v, "mutation struct push [1][0].v");
    assert_eq_int(40, ms[2][0].v, "mutation struct push [2][0].v");

    // Nested loop filling 3D
    print("-- loop fill 3D --");
    let cube: int[3][3][3];
    let counter: int = 0;
    for (let i = 0; i < 3; i++) {
        for (let j = 0; j < 3; j++) {
            for (let k = 0; k < 3; k++) {
                cube[i][j][k] = counter;
                counter++;
            }
        }
    }
    assert_eq_int(0, cube[0][0][0], "loop fill [0][0][0]");
    assert_eq_int(13, cube[1][1][1], "loop fill [1][1][1]");
    assert_eq_int(26, cube[2][2][2], "loop fill [2][2][2]");

    // Sum with nested loop
    let sum: int = 0;
    for (let i = 0; i < 3; i++) {
        for (let j = 0; j < 3; j++) {
            for (let k = 0; k < 3; k++) {
                sum = sum + cube[i][j][k];
            }
        }
    }
    // sum 0..26 = 26*27/2 = 351
    assert_eq_int(351, sum, "loop sum 3D cube");

    // 4D all-fixed int
    print("-- 4D mutation --");
    let d4: int[2][2][2][2];
    d4[0][0][0][0] = 1; d4[1][1][1][1] = 16; d4[0][1][0][1] = 77;
    assert_eq_int(1, d4[0][0][0][0], "4D mut [0][0][0][0]");
    assert_eq_int(16, d4[1][1][1][1], "4D mut [1][1][1][1]");
    assert_eq_int(77, d4[0][1][0][1], "4D mut [0][1][0][1]");
    assert_eq_int(0, d4[0][0][0][1], "4D mut uninit [0][0][0][1]");

    // 4D mixed: dynamic innermost
    print("-- 4D mixed dyn inner --");
    let d4m: int[][2][2][3];
    d4m[0][0][0].push(111);
    d4m[2][1][1].push(999);
    assert_eq_int(111, d4m[0][0][0][0], "4D mixed push [0][0][0][0]");
    assert_eq_int(999, d4m[2][1][1][0], "4D mixed push [2][1][1][0]");
}

// ─── MAIN ───────────────────────────────────────────────────────────────────
function main() {
    print("=== COMPREHENSIVE ARRAY TESTS START ===");
    test_int_arrays();
    test_float_arrays();
    test_bool_arrays();
    test_string_arrays();
    test_struct_arrays();
    test_class_arrays();
    test_mutations_and_edges();
    print("=== COMPREHENSIVE ARRAY TESTS COMPLETE ===");
}
