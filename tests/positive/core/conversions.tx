import { assert_eq_int, assert_eq_string, assert_false, assert_true } from "../utils.tx";

function test_boolean_conversions() {
    print("--- Boolean Conversions ---");
    
    // Only accepts string: returns true if text is 'true' (case-insensitive/trimmed), otherwise false
    assert_true(Boolean("true"), "Boolean(\"true\")");
    assert_true(Boolean("True"), "Boolean(\"True\")");
    assert_true(Boolean("TRUE"), "Boolean(\"TRUE\")");
    assert_true(Boolean(" true "), "Boolean(\" true \")");

    assert_false(Boolean("false"), "Boolean(\"false\")");
    assert_false(Boolean("False"), "Boolean(\"False\")");
    assert_false(Boolean("FALSE"), "Boolean(\"FALSE\")");
    assert_false(Boolean(""), "Boolean(\"\")");
    assert_false(Boolean("   "), "Boolean(\"   \")");
    assert_false(Boolean("0"), "Boolean(\"0\")");
    assert_false(Boolean("1"), "Boolean(\"1\")");
    assert_false(Boolean("hello"), "Boolean(\"hello\")");
    assert_false(Boolean("random text"), "Boolean(\"random text\")");
}

function test_string_conversions() {
    print("--- String Conversions ---");
    
    // Primitives
    assert_eq_string("true", String(true), "String(true)");
    assert_eq_string("false", String(false), "String(false)");
    assert_eq_string("None", String(None), "String(None)");

    // Numbers
    assert_eq_string("0", String(0), "String(0)");
    assert_eq_string("42", String(42), "String(42)");
    assert_eq_string("-10", String(-10), "String(-10)");
    assert_eq_string("0", String(0.0), "String(0.0)");
    assert_eq_string("3.14", String(3.14), "String(3.14)");

    // Strings
    assert_eq_string("", String(""), "String(\"\")");
    assert_eq_string("hello", String("hello"), "String(\"hello\")");

    // Arrays
    assert_eq_string("[]", String([]), "String([])");
    assert_eq_string("[1, 2, 3]", String([1, 2, 3]), "String([1, 2, 3])");
}

function test_number_class_conversions() {
    print("--- Number Class Conversions ---");
    
    // String to Float & Int
    assert_true(Number.Float("123.45") > 123.0 && Number.Float("123.45") < 124.0, "Number.Float(\"123.45\")");
    assert_eq_int(42, Number.Int("42"), "Number.Int(\"42\")");
    assert_eq_int(0, Number.Int("0"), "Number.Int(\"0\")");
    assert_true(Number.Float("0") == 0.0, "Number.Float(\"0\")");
    assert_true(Number.Float("") == 0.0, "Number.Float(\"\")");

    // Boolean to Number
    assert_true(Number.Float(true) == 1.0, "Number.Float(true)");
    assert_true(Number.Float(false) == 0.0, "Number.Float(false)");
    assert_eq_int(1, Number.Int(true), "Number.Int(true)");
    assert_eq_int(0, Number.Int(false), "Number.Int(false)");

    // None to Number
    assert_true(Number.Float(None) == 0.0, "Number.Float(None)");
    assert_eq_int(0, Number.Int(None), "Number.Int(None)");

    // Numeric primitives
    assert_eq_int(42, Number.Int(42), "Number.Int(42)");
    assert_eq_int(3, Number.Int(3.14), "Number.Int(3.14)");
    assert_true(Number.Float(42) == 42.0, "Number.Float(42)");

    // Width-specific variants
    let int8_val: int8 = Number.Int8("120");
    assert_eq_int(120, int8_val as int, "Number.Int8 conversion");
    let int16_val: int16 = Number.Int16("30000");
    assert_eq_int(30000, int16_val as int, "Number.Int16 conversion");
    let int64_val: int64 = Number.Int64("9876543210");
    assert_true(int64_val > 9000000000, "Number.Int64 conversion");
    let uint_val: uint32 = Number.UInt32("50000");
    assert_eq_int(50000, uint_val as int, "Number.UInt32 conversion");
}

function main() {
    print("=== CONVERSION TESTS START ===");
    test_boolean_conversions();
    test_string_conversions();
    test_number_class_conversions();
    print("=== CONVERSION TESTS COMPLETE ===");
}
