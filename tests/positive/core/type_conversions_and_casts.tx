// Production-Grade Test Suite: Type Conversions and Explicit Casts
// ==============================================================
// Thoroughly tests:
// 1. Numeric widening (int8 -> int16 -> int32 -> int64)
// 2. Numeric narrowing / truncation (int64 -> int32 -> int16 -> int8)
// 3. Unsigned widening & narrowing (uint8 <-> uint16 <-> uint32 <-> uint64)
// 4. Signed to Unsigned conversions and vice versa
// 5. Float to Int (truncation) and Int to Float
// 6. Float32 to Float64 precision widening and narrowing
// 7. Char to Int and Int to Char conversions
// 8. Class hierarchy downcasting via 'as' and 'instanceof' validation
// 9. Interface downcasting

import { assert_eq_int, assert_eq_string, assert_true, assert_false } from "../utils.tx";

interface Printable {
    toString(): string;
}

class Entity implements Printable {
    id: int;
    constructor(id: int) {
        this.id = id;
    }
    toString(): string {
        return "Entity(" + this.id + ")";
    }
}

class User extends Entity {
    name: string;
    constructor(id: int, name: string) {
        super(id);
        this.name = name;
    }
    toString(): string {
        return "User(" + this.id + ", " + this.name + ")";
    }
    getRole(): string {
        return "Admin";
    }
}

function test_integer_widening() {
    print("--- Integer Widening ---");

    let s8: int8 = 100;
    let s16: int16 = s8 as int16;
    let s32: int32 = s16 as int32;
    let s64: int64 = s32 as int64;

    assert_eq_int(100, s16, "int8 to int16");
    assert_eq_int(100, s32, "int16 to int32");
    assert_true(s64 == 100, "int32 to int64");

    // Negative sign extension
    let neg8: int8 = -42;
    let neg16: int16 = neg8 as int16;
    let neg32: int32 = neg16 as int32;
    let neg64: int64 = neg32 as int64;

    assert_eq_int(-42, neg16, "negative int8 to int16");
    assert_eq_int(-42, neg32, "negative int16 to int32");
    assert_true(neg64 == -42, "negative int32 to int64");
}

function test_integer_narrowing() {
    print("--- Integer Narrowing ---");

    // Narrowing without truncation (within range)
    let s64: int64 = 30000;
    let s32: int32 = s64 as int32;
    let s16: int16 = s32 as int16;
    assert_eq_int(30000, s32, "int64 to int32 in range");
    assert_eq_int(30000, s16, "int32 to int16 in range");

    // Narrowing with truncation (overflow)
    // 300 in uint8: 300 % 256 = 44
    let val: int = 300;
    let u8_val: uint8 = val as uint8;
    assert_eq_int(44, u8_val, "300 truncated to uint8 (300 % 256 = 44)");

    // 70000 in uint16: 70000 % 65536 = 4464
    let bigVal: int = 70000;
    let u16_val: uint16 = bigVal as uint16;
    assert_eq_int(4464, u16_val, "70000 truncated to uint16 (70000 % 65536 = 4464)");
}

function test_signed_unsigned_casts() {
    print("--- Signed/Unsigned Casts ---");

    // Positive values preserve magnitude
    let u32: uint32 = 12345;
    let s32: int32 = u32 as int32;
    assert_eq_int(12345, s32, "uint32 to int32 positive");

    let s: int = 54321;
    let u: uint = s as uint;
    assert_true(u == 54321, "int32 to uint32 positive");
}

function test_float_int_conversions() {
    print("--- Float <-> Int Conversions ---");

    let f1: float64 = 42.89;
    let truncated: int = f1 as int;
    assert_eq_int(42, truncated, "float64 to int truncates towards zero");

    let negF: float64 = -15.75;
    let negTruncated: int = negF as int;
    assert_eq_int(-15, negTruncated, "negative float to int truncates towards zero");

    let i: int = 1234;
    let f2: float64 = i as float64;
    assert_true(f2 > 1233.9 && f2 < 1234.1, "int to float64");

    // Float32 <-> Float64
    let f32_val: float32 = 3.5;
    let f64_val: float64 = f32_val as float64;
    assert_true(f64_val > 3.49 && f64_val < 3.51, "float32 to float64");
}

function test_char_conversions() {
    print("--- Char <-> String Conversions ---");

    let s: string = "A";
    let c: char = s as char;
    assert_true(c == 'A', "string 'A' as char");

    let c2: char = 'Z';
    let s2: string = c2 as string;
    assert_eq_string("Z", s2, "char 'Z' as string");

    let ch: char = '9';
    let strNum: string = ch as string;
    assert_eq_string("9", strNum, "char '9' as string");
}

function test_object_downcasting() {
    print("--- Object Downcasting & Instanceof ---");

    let e: Entity = new User(1, "Alice");
    assert_true(e instanceof User, "e instanceof User is true");
    assert_true(e instanceof Entity, "e instanceof Entity is true");

    // Downcast via 'as'
    let u: User = e as User;
    assert_eq_string("Alice", u.name, "Downcasted User name");
    assert_eq_string("Admin", u.getRole(), "Downcasted User getRole");

    // Plain entity is NOT a User
    let plain: Entity = new Entity(2);
    assert_false(plain instanceof User, "plain instanceof User is false");
    assert_true(plain instanceof Entity, "plain instanceof Entity is true");

    // Base class downcast
    let e2: Entity = new User(3, "Bob");
    assert_true(e2 instanceof User, "e2 instanceof User");
    let u2 = e2 as User;
    assert_eq_string("User(3, Bob)", u2.toString(), "Downcasted method call toString");
    assert_eq_string("Bob", u2.name, "Base downcast to User");
    assert_eq_string("Admin", u2.getRole(), "Downcasted method getRole");
}

function main() {
    print("=== TYPE CONVERSIONS AND CASTS TEST START ===");
    test_integer_widening();
    test_integer_narrowing();
    test_signed_unsigned_casts();
    test_float_int_conversions();
    test_char_conversions();
    test_object_downcasting();
    print("=== TYPE CONVERSIONS AND CASTS TEST COMPLETE ===");
}
