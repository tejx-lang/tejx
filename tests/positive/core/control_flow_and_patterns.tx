// Production-Grade Test Suite: Control Flow & Error Handling
// ==========================================================
// Thoroughly exercises:
// - Switch-case statements (int, break, default fallback)
// - For loops (step variations, early break, continue)
// - While loops (break, continue, nested)
// - Deeply nested if-else branch evaluation
// - Exhaustive try-catch-finally flows:
//   * Exception thrown and caught
//   * Finally execution on normal completion
//   * Finally execution on early return from try
//   * Finally execution on early return from catch
//   * Nested try-catch-finally blocks

import { assert_eq_int, assert_eq_string, assert_true, assert_false } from "../utils.tx";

class FinallyMarker {
    ran: bool = false;
    constructor() {}
}

function test_switch_cases() {
    print("--- Testing Switch-Case Statements ---");

    function get_weekday_name(day: int): string {
        switch (day) {
            case 1:
                return "Monday";
            case 2:
                return "Tuesday";
            case 3:
                return "Wednesday";
            case 4:
                return "Thursday";
            case 5:
                return "Friday";
            case 6:
                return "Saturday";
            case 7:
                return "Sunday";
            default:
                return "Invalid";
        }
    }

    assert_eq_string("Monday", get_weekday_name(1), "Day 1 is Monday");
    assert_eq_string("Friday", get_weekday_name(5), "Day 5 is Friday");
    assert_eq_string("Sunday", get_weekday_name(7), "Day 7 is Sunday");
    assert_eq_string("Invalid", get_weekday_name(0), "Day 0 is Invalid");
    assert_eq_string("Invalid", get_weekday_name(8), "Day 8 is Invalid");
}

function test_loops_and_breaks() {
    print("--- Testing Loops, Breaks & Continues ---");

    // For loop with continue (skip even numbers, sum odds 1..9)
    let oddSum = 0;
    for (let i = 1; i <= 9; i++) {
        if (i % 2 == 0) {
            continue;
        }
        oddSum += i;
    }
    assert_eq_int(25, oddSum, "Sum of odds 1+3+5+7+9 == 25");

    // For loop with early break
    let breakIndex = -1;
    for (let i = 0; i < 100; i++) {
        if (i == 42) {
            breakIndex = i;
            break;
        }
    }
    assert_eq_int(42, breakIndex, "Break executed at 42");

    // Nested loops: matrix search
    let targetRow = -1;
    let targetCol = -1;
    let found = false;
    for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
            if (r * 5 + c == 17) {
                targetRow = r;
                targetCol = c;
                found = true;
                break;
            }
        }
        if (found) {
            break;
        }
    }
    assert_eq_int(3, targetRow, "Row 3 for 17");
    assert_eq_int(2, targetCol, "Col 2 for 17");

    // While loop with countdown
    let count = 10;
    let sum = 0;
    while (count > 0) {
        sum += count;
        count--;
    }
    assert_eq_int(55, sum, "While loop countdown sum 10..1 == 55");
}

function test_nested_if_else() {
    print("--- Testing Complex Nested If-Else ---");

    function categorize(val: int): string {
        if (val < 0) {
            return "negative";
        } else if (val == 0) {
            return "zero";
        } else if (val < 10) {
            return "single_digit";
        } else if (val < 100) {
            return "double_digit";
        } else if (val < 1000) {
            return "triple_digit";
        } else {
            return "large";
        }
    }

    assert_eq_string("negative", categorize(-5), "categorize -5");
    assert_eq_string("zero", categorize(0), "categorize 0");
    assert_eq_string("single_digit", categorize(7), "categorize 7");
    assert_eq_string("double_digit", categorize(42), "categorize 42");
    assert_eq_string("triple_digit", categorize(999), "categorize 999");
    assert_eq_string("large", categorize(10000), "categorize 10000");
}

function test_try_catch_finally_flows() {
    print("--- Testing Try-Catch-Finally Flows ---");

    // Scenario 1: Normal try with finally
    let flow1 = "";
    try {
        flow1 = flow1 + "try;";
    } catch (e) {
        flow1 = flow1 + "catch;";
    } finally {
        flow1 = flow1 + "finally;";
    }
    assert_eq_string("try;finally;", flow1, "Normal try-finally flow");

    // Scenario 2: Exception thrown, caught, followed by finally
    let flow2 = "";
    try {
        flow2 = flow2 + "try;";
        throw new Error("test_err");
    } catch (e) {
        flow2 = flow2 + "catch;";
    } finally {
        flow2 = flow2 + "finally;";
    }
    assert_eq_string("try;catch;finally;", flow2, "Exception caught then finally");

    // Scenario 3: Finally executes on early return from try
    let marker = new FinallyMarker();
    function early_return_test(m: FinallyMarker): int {
        try {
            return 100;
        } finally {
            m.ran = true;
        }
    }
    let res = early_return_test(marker);
    assert_eq_int(100, res, "Early return value");
    assert_true(marker.ran, "Finally executed despite early return");

    // Scenario 4: Nested try-catch-finally
    let nested_flow = "";
    try {
        nested_flow = nested_flow + "outer_try;";
        try {
            nested_flow = nested_flow + "inner_try;";
            throw new Error("inner_boom");
        } catch (inner_err) {
            nested_flow = nested_flow + "inner_catch;";
        } finally {
            nested_flow = nested_flow + "inner_finally;";
        }
    } catch (outer_err) {
        nested_flow = nested_flow + "outer_catch;";
    } finally {
        nested_flow = nested_flow + "outer_finally;";
    }
    assert_eq_string("outer_try;inner_try;inner_catch;inner_finally;outer_finally;", nested_flow, "Nested try-catch-finally execution order");
}

function main() {
    print("=== CONTROL FLOW & ERROR HANDLING TESTS START ===");
    test_switch_cases();
    test_loops_and_breaks();
    test_nested_if_else();
    test_try_catch_finally_flows();
    print("=== CONTROL FLOW & ERROR HANDLING TESTS COMPLETE ===");
}
