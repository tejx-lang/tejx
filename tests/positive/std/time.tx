// Time Tests
// ==========
import { now } from "std:time";
import { sleep } from "std:thread";
import { assert_eq_int, assert_true } from "../utils.tx";



function test_sleep() {
    print("--- Sync Sleep ---");
    let start = now();
    sleep(200);
    let end = now();
    let diff = end - start;
    assert_true(diff >= 200, "Sync sleep >= 200ms");
    print("Sync sleep diff: ", diff);
}

function test_time_intense(): void {
    print("--- Time Intense Precision Test ---");
    let call_times: int[] = [];
    let start = now();
    for (let i = 0; i < 10000; i++) {
        call_times.push(now());
    }
    let totalTime = now() - start;
    assert_true(totalTime >= 0, "10000 now() calls should take >= 0 ms");
    assert_true(call_times.length() == 10000, "10000 times recorded");
}

function main() {
    print("=== TIME TESTS START ===");
    let start = now();
    assert_true(start > 0, "time.now() positive");
    
    test_sleep();
    test_time_intense();
    print("=== TIME TESTS COMPLETE ===");
}
