// IO & FileSystem Tests
// =====================
import std:fs;
import { assert_eq_int, assert_eq_string, assert_true, assert_false } from "../utils.tx";

function test_output() {
    print("--- Output Test ---");
    print("Sending to stdout...");
    // Hard to assert output without capturing it, but ensuring it runs is good.
}

function test_fs_sync() {
    print("--- FS Sync Test ---");
    let path = "test_io_sync.txt";
    if (fs.exists(path)) fs.unlink(path);

    // Write/Read
    fs.writeFile(path, "Hello IO");
    assert_true(fs.exists(path), "File created");
    
    let content = fs.readFile(path);
    assert_eq_string("Hello IO", content, "Read content");

    // Append
    fs.appendFile(path, " World");
    let appended = fs.readFile(path);
    assert_eq_string("Hello IO World", appended, "Appended content");

    // Unlink
    fs.unlink(path);
    assert_false(fs.exists(path), "File deleted");
}

function test_fs_async() {
    print("--- FS Async Test ---");
    let path = "test_io_async.txt";
    if (fs.exists(path)) fs.unlink(path);

    fs.writeFile(path, "Hello Async IO");
    assert_true(fs.exists(path), "Async File created");

    let content = fs.readFile(path);
    assert_eq_string("Hello Async IO", content, "Async Read content");

    fs.unlink(path);
    assert_false(fs.exists(path), "Async File deleted");
}

function test_directories() {
    print("--- Directory Test ---");
    let dir = "test_io_dir";
    if (fs.exists(dir)) {
        // fs.rmdir(dir); // assuming unlink handles dirs or rmdir exists? 
        // features_fs.tx used unlinkSync for dirs (likely recursive or system call wrapper)
        fs.unlink(dir);
    }
    
    fs.mkdir(dir);
    assert_true(fs.exists(dir), "Dir created");

    let filePath = dir + "/file1.txt";
    fs.writeFile(filePath, "1");
    assert_true(fs.exists(filePath), "File in dir created");

    let files = fs.readdir(dir);
    // Depending on impl, might include . or ..? Usually just entries.
    // If we just created 1 file, length should be 1.
    assert_eq_int(1, files.length(), "Dir files count");

    fs.unlink(dir);
    assert_false(fs.exists(dir), "Dir deleted");
}

function test_fs_intense() {
    print("--- FS Intense Test ---");
    let intense_dir = "test_io_intense_dir";
    if (fs.exists(intense_dir)) {
        fs.unlink(intense_dir);
    }
    fs.mkdir(intense_dir);
    
    // Create 100 files sequentially to stress file system
    for (let i = 0; i < 100; i++) {
        let fpath = intense_dir + "/file_" + i + ".txt";
        fs.writeFile(fpath, "Data payload for file " + i);
    }
    
    let files = fs.readdir(intense_dir);
    assert_eq_int(100, files.length(), "100 files created");
    
    // Read and verify a random one
    let content = fs.readFile(intense_dir + "/file_42.txt");
    assert_eq_string("Data payload for file 42", content, "Intense file 42 content");
    
    // Cleanup
    for (let i = 0; i < 100; i++) {
        let fpath = intense_dir + "/file_" + i + ".txt";
        fs.unlink(fpath);
    }
    
    fs.unlink(intense_dir);
    assert_false(fs.exists(intense_dir), "Intense dir cleaned up");
}

function main() {
    print("=== IO TESTS START ===");
    test_output();
    test_fs_sync();
    test_fs_async();
    test_directories();
    test_fs_intense();
    print("=== IO TESTS COMPLETE ===");
}
