import { collect } from "std:gc";
import { afterMs, everyMs } from "std:time";
import { Atomic, sleep } from "std:thread";
import { assert_true } from "../utils.tx";

let untrackedFires: Atomic = new Atomic(0);

function allocateUntrackedTimers(): void {
    print("ALLOCATING TIMERS");
    for (let i = 0; i < 10; i++) {
        afterMs(() => {
            print("TIMER FIRED");
            untrackedFires.increment();
        }, 25);
    }
}

function createMemoryPressure(): void {
    let junk: string[] = [];
    for (let i = 0; i < 120000; i++) {
        junk.push("timer-gc-" + i + "-pressure-" + (i * 2));
        if (junk.length() > 2048) {
            junk = [];
        }
    }
}

function main(): void {
    print("=== TIME WRAPPER GC START ===");

    allocateUntrackedTimers();
    
    print("STARTING MEMORY PRESSURE");
    createMemoryPressure();
    print("MEMORY PRESSURE DONE, TRIGGERING GC");

    collect();
    print("GC DONE, SLEEPING");
    sleep(300); // 300ms is plenty now that there's no staggering
    assert_true(untrackedFires.load() == 10, "GC'd timer wrappers DO NOT get cancelled");
    print("=== TIME WRAPPER GC COMPLETE ===");
}
