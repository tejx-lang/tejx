import { clearTimeout, setTimeout } from "std:time";
import { sleep } from "std:thread";
import { assert_true } from "../utils.tx";

function main() {
    print("=== TIME CANCELLATION START ===");

    let fired = false;
    let id = setTimeout(() => {
        fired = true;
    }, 20000);

    clearTimeout(id);
    sleep(25);

    assert_true(!fired, "cleared timeout does not fire");
    print("=== TIME CANCELLATION COMPLETE ===");
}
