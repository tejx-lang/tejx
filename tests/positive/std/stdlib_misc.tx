// Stdlib Misc Tests
// =================
import std:math;
import std:fs;
import std:system; 
import { assert_eq_int, assert_eq_string, assert_true } from "../utils.tx";

function test_extra_arrays() {
    print("--- Extra Array Methods ---");
    let arr = [3, 1, 2];
    arr.sort();
    assert_eq_int(1, arr[0], "sort[0]");
    assert_eq_int(2, arr[1], "sort[1]");
    
    
    assert_true(arr.includes(2), "includes(2)");
}

function test_extra_strings() {
    print("--- Extra String Methods ---");
    let s = "  hello  ";
    assert_eq_string("hello  ", s.trimStart(), "trimStart");
    assert_eq_string("  hello", s.trimEnd(), "trimEnd");
    
    let s2 = "hello world";
    assert_true(s2.includes("world"), "includes");
    assert_eq_int(6, s2.indexOf("world"), "indexOf");
}

function test_stdlib_wrappers() {
    print("--- Stdlib Wrappers (Math/FS/OS) ---");
    // Math wrappers
    assert_eq_int(42, abs(-42), "abs");
    assert_eq_int(1024, pow(2, 10), "pow");
    assert_eq_int(5, sqrt(25), "sqrt");
    assert_eq_int(5, clamp(99, 0, 5), "clamp");
    
    let file = "stdlib_misc.txt";
    if (fs.exists(file)) {
        fs.remove(file);
    }
    writeFile(file, "std");
    assert_true(exists(file), "top-level fs exists");
    assert_eq_string("std", readFile(file), "top-level fs readFile");
    remove(file);
    
    // OS
    let runtimeArgs = args();
    assert_eq_int(1, runtimeArgs.length(), "args count");
    assert_eq_int(runtimeArgs.length(), system.args().length(), "system.args length");
}

function test_class_math_and_array() {
    print("--- Math Class & Array / Boolean Utilities ---");
    assert_true(Array.isArray([1, 2, 3]), "Array.isArray");
    assert_true(!Array.isArray("string"), "Array.isArray negative");
    assert_true(Boolean(true), "Boolean(true)");
    assert_true(!Boolean(None), "Boolean(None)");

    assert_true(Math.PI() > 3.14 && Math.PI() < 3.15, "Math.PI()");
    assert_true(Math.pi() > 3.14 && Math.pi() < 3.15, "Math.pi()");
    assert_true(Math.E() > 2.71 && Math.E() < 2.72, "Math.E()");
    assert_true(Math.TAU() > 6.28 && Math.TAU() < 6.29, "Math.TAU()");
    assert_eq_int(42, Math.abs(-42), "Math.abs");
    assert_eq_int(5, Math.sqrt(25), "Math.sqrt");
    assert_eq_int(100, Math.max(50, 100), "Math.max");
    assert_eq_int(50, Math.min(50, 100), "Math.min");
    assert_true(math.PI() > 3.14 && math.PI() < 3.15, "math.PI()");
}

function main() {
    print("=== STDLIB MISC START ===");
    test_extra_arrays();
    test_extra_strings();
    test_stdlib_wrappers();
    test_class_math_and_array();
    print("=== STDLIB MISC COMPLETE ===");
}

